# ---- 必填 ----
# 管理后台解锁密码（进入网页控制台用）。不设置时启动会随机生成并打印在 Railway 日志里。
ADMIN_PASSWORD=change-me-please

# ---- 常用 ----
# 数据目录。Railway 上挂一个 Volume 到 /data，账号和 key 才能在重新部署后保留。
DATA_DIR=/data
# 端口。Railway 会自动注入 PORT，本地调试才需要
PORT=8787

# 首个 API key（不填则首次启动自动生成一个随机 key，可在控制台查看/新建）
FREEBUFF_API_KEY=
# 预置账号 token（逗号或换行分隔），一般不用填，直接在控制台加号更方便
FREEBUFF_TOKEN=

# ---- opencode Zen 号池（第二个上游，可选）----
# 预置 Zen API key（逗号或换行分隔）。自己去 https://opencode.ai/zen 登录后复制，
# 也可以在控制台「添加账号 → opencode Zen」里粘贴。加进来的号默认只服务免费模型。
OPENCODE_API_KEY=
# 号池里没有 opencode 号时，是否用官方 CLI 的 public 匿名凭证调 Zen 的免费模型。
# 上游按出口 IP 限流，共享 IP 上很容易 429；不想用就设 false。
OPENCODE_ANONYMOUS=true
# Zen 的接口地址，一般不用改
OPENCODE_API=https://opencode.ai/zen/v1

# ---- 自定义上游 ----
# 允许自定义上游填内网 / 云元数据地址。默认 false：这个服务通常跑在公网容器里，
# 填内网地址等于把网关变成打内网的跳板。只有确实要连内网服务时才打开。
ALLOW_PRIVATE_UPSTREAM=false

# ---- 内置浏览器（服务器端 patchright Chromium）----
# false = 完全关闭内置浏览器登录（镜像也可用 --build-arg INSTALL_CHROMIUM=false 构建）
ENABLE_BROWSER_LOGIN=true
# auto | true | false ：auto=有 DISPLAY(Xvfb) 就 headful，没有就 headless
BROWSER_HEADLESS=auto
# 给内置浏览器走代理（例如需要美国出口时）：http://user:pass@host:port 或 socks5://host:port
BROWSER_PROXY=

# ---- 其它 ----
# 新建 API key 时「允许付费(Premium)模型」复选框的默认值
ALLOW_PAID_DEFAULT=false
# worker 调试日志
FREEBUFF_DEBUG=false
# 管理会话 cookie 签名密钥，不填则自动生成并存到数据目录
SESSION_SECRET=

# ---- 安全 / 容量（都有合理默认，一般不用动）----
# 前面有几层可信代理：限流取 X-Forwarded-For 最右边这几跳（Railway = 1）
TRUST_PROXY_HOPS=1
# 绑了自定义域名时填它，控制台里显示的 Base URL 就用这个
PUBLIC_BASE_URL=
# 单请求体上限（MB）/ 同时在飞的 /v1 请求数 / 同时最多几个内置浏览器
MAX_BODY_MB=8
MAX_INFLIGHT_API=32
MAX_BROWSER_SESSIONS=2
# 允许内置浏览器访问内网、云元数据地址（默认 false，防 SSRF）
BROWSER_ALLOW_PRIVATE=false
